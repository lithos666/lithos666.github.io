# Auto generate line endings based on platform
* text=auto eol=lf

# PowerShell scripts should use CRLF on Windows
*.ps1 -text eol=crlf

# JavaScript/TypeScript files
*.js -text eol=lf
*.jsx -text eol=lf

# Configuration files
*.json -text eol=lf
*.yaml -text eol=lf
*.yml -text eol=lf

# CSS and HTML
*.css -text eol=lf
*.html -text eol=lf

# Markdown files
*.md -text eol=lf

# Shell scripts for Linux/Mac
*.sh -text eol=lf

# Ignore binary files
*.png -diff
*.jpg -diff
*.jpeg -diff
*.gif -diff
*.svg -diff
*.pdf -diff
